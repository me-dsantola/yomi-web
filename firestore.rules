rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isModerator() {
      return isSignedIn() && request.auth.token.moderator == true;
    }

    function isValidCommentText(text) {
      return text is string && text.size() >= 1 && text.size() <= 800;
    }

    function isValidCommentTarget() {
      return request.resource.data.targetId is string
        && request.resource.data.targetId.size() >= 1
        && request.resource.data.targetId.size() <= 160
        && request.resource.data.targetType in ['manga', 'chapter'];
    }

    function isValidReactionUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let prevLikedBy = resource.data.likedBy;
      let nextLikedBy = request.resource.data.likedBy;
      let addedSelf = !prevLikedBy.hasAll([request.auth.uid])
        && nextLikedBy.hasAll([request.auth.uid])
        && nextLikedBy.hasAll(prevLikedBy)
        && nextLikedBy.size() == prevLikedBy.size() + 1;
      let removedSelf = prevLikedBy.hasAll([request.auth.uid])
        && !nextLikedBy.hasAll([request.auth.uid])
        && prevLikedBy.hasAll(nextLikedBy)
        && nextLikedBy.size() == prevLikedBy.size() - 1;

      return changedKeys.hasOnly(['likes', 'likedBy'])
        && nextLikedBy is list
        && request.resource.data.likes is int
        && request.resource.data.likes == nextLikedBy.size()
        && (addedSelf || removedSelf);
    }

    // Backups e sincronização na nuvem (.kuro v4) isolados por usuário
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Coleção compartilhada de comentários (Yomi Web + Yomi App Flutter)
    match /comments/{commentId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && isValidCommentTarget()
        && isValidCommentText(request.resource.data.text)
        && request.resource.data.userName is string
        && request.resource.data.userName.size() >= 1
        && request.resource.data.userName.size() <= 100
        && request.resource.data.isSpoiler is bool
        && request.resource.data.likes == 0
        && request.resource.data.likedBy is list
        && request.resource.data.likedBy.size() == 0
        && (
          request.resource.data.createdAt is int
          || request.resource.data.createdAt is timestamp
        );

      allow update: if isSignedIn() && (
        isValidReactionUpdate()
        || (
          resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.targetId == resource.data.targetId
          && request.resource.data.targetType == resource.data.targetType
          && request.resource.data.createdAt == resource.data.createdAt
          && isValidCommentText(request.resource.data.text)
        )
      );

      allow delete: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isModerator());
    }
  }
}
